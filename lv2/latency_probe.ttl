@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/tothoseofus/piStomp-MIDI-Latency-Probe>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "piStomp MIDI Latency Probe" ;
    doap:homepage <https://github.com/tothoseofus/piStomp-MIDI-Latency-Probe> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ken Spanks" ] ;
    doap:developer [ a foaf:Person ; foaf:name "Ken Spanks" ] ;
    lv2:minorVersion @LV2_MINOR@ ;
    lv2:microVersion @LV2_MICRO@ ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    rdfs:comment "SAFETY WARNING: DO NOT CONNECT THE ENCODED MIDI RIGHT OUTPUT TO SPEAKERS, AMPLIFIERS, HEADPHONES OR AUDIO MONITORING. Diagnostic PCM pulses only; capture to a recorder with monitoring muted. Left output is dry guitar audio." ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "audio_in" ; lv2:name "Dry Guitar In" ],
        [ a lv2:InputPort, atom:AtomPort ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ; lv2:index 1 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "audio_left" ; lv2:name "Dry Audio Left" ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "midi_pcm_right" ; lv2:name "Encoded MIDI Right" ] .
